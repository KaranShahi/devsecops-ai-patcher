# Database
DATABASE_URL=sqlite:///./data/garage.db

# File storage for uploaded supplier invoices
UPLOAD_DIR=./data/uploads

# Your garage's details, printed on customer invoices and sent to Xero
COMPANY_NAME=Your Garage Ltd
COMPANY_ADDRESS_LINE1=1 Workshop Road
COMPANY_ADDRESS_LINE2=Sometown, ST1 1AA
COMPANY_PHONE=01234 567890
COMPANY_EMAIL=info@yourgarage.co.uk
COMPANY_VAT_NUMBER=GB123456789

# Defaults used when raising jobs/invoices (can be overridden per line)
DEFAULT_VAT_RATE=0.20
DEFAULT_PARTS_MARKUP_PCT=25
DEFAULT_LABOR_RATE=65
INVOICE_NUMBER_PREFIX=INV-

# Xero app credentials (create an app at https://developer.xero.com/app/manage)
# Required scopes: openid profile email accounting.contacts accounting.transactions offline_access
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/xero/callback

SECRET_KEY=change-me-in-production
